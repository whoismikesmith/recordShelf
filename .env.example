# Discogs username whose collection to sync (collection must be public, or supply a token)
DISCOGS_USERNAME=your_username
# Personal access token from https://www.discogs.com/settings/developers (raises rate limit to 60/min)
DISCOGS_TOKEN=

# Optional overrides
# RECORDSHELF_DATA_DIR=data
# RECORDSHELF_LAYOUT_FILE=config/shelf.yaml
# RECORDSHELF_HOST=0.0.0.0
# RECORDSHELF_PORT=8000
# RECORDSHELF_FPS=30
